<!-- Élément racine -->
<!ELEMENT bibliographies (bibliography*)>
<!ELEMENT bibliography (entry*)>
<!ELEMENT entry (article | book | inproceedings | incollection | phdthesis | mastersthesis | techreport | manual | misc | unpublished | inbook | proceedings | booklet | conference)>

<!-- Article -->
<!ELEMENT article (author | authors | title | journal | year | volume | number | pages | month | doi | url | abstract | note | editor | address | publisher)*>
<!ATTLIST article id ID #IMPLIED key CDATA #IMPLIED>

<!-- Livre -->
<!ELEMENT book (author | authors | title | publisher | year | volume | series | address | edition | isbn | pages | month | url | abstract | note | editor)*>
<!ATTLIST book id ID #IMPLIED key CDATA #IMPLIED>

<!-- Conférence -->
<!ELEMENT inproceedings (author | authors | title | booktitle | year | volume | pages | month | address | organization | publisher | url | abstract | note | editor | series | number)*>
<!ATTLIST inproceedings id ID #IMPLIED key CDATA #IMPLIED>

<!-- etc. ... -->
